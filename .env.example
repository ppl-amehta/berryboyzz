# ==============================================================================
# BERRYBOYZZ™ — Meta Apex System User & Cross-App Agentic Integration
# Graph API Version: v21.0
# Unified control across: Meta Business Suite, WhatsApp Cloud API, Instagram Graph API
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. META BUSINESS SUITE ROOT SYSTEM USER (Cross-App Controller)
# ------------------------------------------------------------------------------
# Permanent System User Access Token generated with Admin role under:
# Meta Business Settings -> System Users -> [Select/Create Admin System User] -> Generate Token
# Required Scopes:
#   - business_management
#   - whatsapp_business_management
#   - whatsapp_business_messaging
#   - instagram_basic
#   - instagram_manage_messages
#   - pages_show_list
#   - pages_read_engagement
META_SYSTEM_USER_TOKEN=

# Meta Business Manager ID (Found in Business Settings URL or Info)
META_BUSINESS_ID=

# Meta System User ID (Numeric ID of the Admin System User)
META_SYSTEM_USER_ID=

# Meta App ID and App Secret (Found in Meta for Developers -> App -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# Meta Graph API Version (defaults to v21.0)
META_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 2. WHATSAPP BUSINESS CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Connected Official Desk Number: +91 88886 81136
# WhatsApp Phone Number ID (Found in WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=1127117767143751

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=986204240417120

# Fallback/Direct Token (if not using unified META_SYSTEM_USER_TOKEN)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# 3. INSTAGRAM PROFESSIONAL / GRAPH API CONFIGURATION
# ------------------------------------------------------------------------------
# Connected Instagram Business Account ID (e.g., 17841400012345678)
# Found via Meta Business Settings -> Accounts -> Instagram Accounts, or Graph Explorer: GET /me/accounts -> instagram_business_account
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 4. UNIFIED WEBHOOK SECRETS & SIGNATURES
# ------------------------------------------------------------------------------
# Shared verification token used during Meta Webhook subscription challenge (GET)
META_WEBHOOK_VERIFY_TOKEN=berryboyzz_webhook_verify_token_2026
WHATSAPP_VERIFY_TOKEN=berryboyzz_webhook_verify_token_2026
