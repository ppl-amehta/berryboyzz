# ==============================================================================
# BERRYBOYZZ™ — Official WhatsApp Business Cloud API Configuration
# Connected WhatsApp Business Number: +91 88886 81136
# Meta Graph API Version: v21.0
# ==============================================================================

# 1. Meta Phone Number ID (Unique 15-digit ID assigned to 918888681136 in Meta Business Suite)
# Found in: Meta for Developers -> WhatsApp -> API Setup -> Phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# 2. Meta WhatsApp Business Account ID (WABA ID)
# Found in: Meta Business Suite -> Settings -> WhatsApp Accounts
WHATSAPP_BUSINESS_ACCOUNT_ID=

# 3. Permanent System User Access Token (Bearer Token with whatsapp_business_messaging permissions)
# Generate under: Meta Business Settings -> System Users -> Generate Token
WHATSAPP_ACCESS_TOKEN=

# 4. Custom Webhook Verification Secret Token (Shared secret between Meta and your Webhook endpoint)
# Set your own string here, then paste the identical value into Meta Webhook Configuration
WHATSAPP_VERIFY_TOKEN=berryboyzz_webhook_verify_token_2026

# 5. Meta App Secret (Used to verify X-Hub-Signature-256 HMAC payload signatures)
# Found in: Meta for Developers -> App Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=

# 6. Meta Graph API Version
WHATSAPP_API_VERSION=v21.0
