# ==============================================================================
# BERRYBOYZZ™ — Frontier Production Environment & Secrets Architecture
# ==============================================================================
# In production, NEVER commit raw secret values.
# - Cloud Runtime Secrets: Injected via Vercel Project Settings -> Environment Variables
# - CI/CD Pipeline Secrets: Injected via GitHub Repository Settings -> Secrets and variables -> Actions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CI/CD & VERCEL AUTOMATION SECRETS (Required in GitHub Repository Secrets)
# ------------------------------------------------------------------------------
# Vercel Personal Access Token generated under: Vercel Dashboard -> Account Settings -> Tokens
VERCEL_TOKEN=

# Vercel Organization / Team ID (e.g., team_bm3YcarbVS0iXhALfg9ysiZi)
VERCEL_ORG_ID=team_bm3YcarbVS0iXhALfg9ysiZi

# Vercel Project ID (e.g., prj_47ijuZlhC4AwCG1rfUbxiYwPJwsK)
VERCEL_PROJECT_ID=prj_47ijuZlhC4AwCG1rfUbxiYwPJwsK

# ------------------------------------------------------------------------------
# 2. META APEX SYSTEM USER & CROSS-APP CONTROLLER (Meta Graph API v26.0)
# ------------------------------------------------------------------------------
# Permanent System User Access Token generated with Admin role under:
# Meta Business Settings -> System Users -> [Admin System User] -> Generate Token
# Required Scopes:
#   - business_management
#   - whatsapp_business_management
#   - whatsapp_business_messaging
#   - instagram_basic
#   - instagram_manage_messages
#   - pages_show_list
#   - pages_read_engagement
META_SYSTEM_USER_TOKEN=

# Meta Business Manager ID
META_BUSINESS_ID=

# Meta System User ID (Numeric ID of the Admin System User)
META_SYSTEM_USER_ID=

# Meta App ID and App Secret (Found in Meta for Developers -> App -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=

# Meta Graph API Version (defaults to v26.0)
META_API_VERSION=v26.0

# ------------------------------------------------------------------------------
# 3. WHATSAPP BUSINESS CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Connected Official Desk Number: +91 88886 81136
# WhatsApp Phone Number ID (Found in WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=1127117767143751

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=986204240417120

# Direct / Fallback Access Token (if not using unified META_SYSTEM_USER_TOKEN)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0

# ------------------------------------------------------------------------------
# 4. INSTAGRAM PROFESSIONAL / GRAPH API CONFIGURATION
# ------------------------------------------------------------------------------
# Connected Instagram Business Account ID (e.g., 17841400012345678)
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 5. UNIFIED WEBHOOK SECRETS & SIGNATURES
# ------------------------------------------------------------------------------
# Shared verification token used during Meta Webhook subscription challenge (GET)
META_WEBHOOK_VERIFY_TOKEN=berryboyzz_webhook_verify_token_2026
WHATSAPP_VERIFY_TOKEN=berryboyzz_webhook_verify_token_2026

# ------------------------------------------------------------------------------
# 6. AGRO-EXPERT SLM CASCADE API KEYS (Optional / Multi-Provider Fallbacks)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
